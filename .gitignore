# Ignore local data
data/
*.csv
*.xlsx
*.parquet

# Ignore trained models and large serialized objects
models/
*.pkl
*.joblib
*.h5

# Keep deployment artifacts required by the FastAPI backend
!backend/fraud_model.pkl
!backend/scaler.pkl
!backend/fraud_threshold.pkl

# Ignore Python environment and cache files
__pycache__/
*.pyc
.venv/
venv/
.env

# Ignore Jupyter checkpoint files
.ipynb_checkpoints/

# Ignore Jupyter/CatBoost generated files
.ipynb_checkpoints/
notebooks/catboost_info/

# Ignore OS specific files
.DS_Store
Thumbs.db